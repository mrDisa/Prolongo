# Copy to .env before the first run:  cp .env.example .env
# Values below are for local development only.

POSTGRES_DB=prolongo
POSTGRES_USER=prolongo
POSTGRES_PASSWORD=prolongo
DATABASE_URL=postgres://prolongo:prolongo@postgres:5432/prolongo?sslmode=disable

# Panel login (created on core startup)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin123
SESSION_TTL_HOURS=12
COOKIE_SECURE=false

# Prometheus scrapes /metrics with this bearer token
METRICS_TOKEN=change-me-metrics-token

# Django
DJANGO_SECRET_KEY=change-me
DJANGO_DEBUG=0

# 1 = load extended demo data on first start (manage.py generate_demo)
DEMO_DATA=0

# Recalculation
RECALC_INTERVAL_SECONDS=60
RECALC_DEBOUNCE_MS=300

# OIDC (bonus): docker compose --profile oidc up
OIDC_ENABLED=0
OIDC_ISSUER_URL=http://localhost:8081/realms/prolongo
OIDC_CLIENT_ID=prolongo
OIDC_CLIENT_SECRET=prolongo-secret
OIDC_REDIRECT_URL=http://localhost:8080/api/v1/auth/oidc/callback
