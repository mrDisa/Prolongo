# Where the dev server proxies /api. The real stack is the default.
#   http://localhost:8080  - real API (docker compose up)
#   http://localhost:4010  - Prism mock (npm run mock)
VITE_API_TARGET=http://localhost:8080

# Simulate SSE recalculations every 15 seconds when developing against Prism.
VITE_FAKE_LIVE=0

# Show the "Войти через SSO" button on the login page (1 = show).
# The API does not tell an anonymous visitor whether OIDC is on, so for now
# this is a build-time switch; keep it in line with OIDC_ENABLED in the root .env.
VITE_OIDC_ENABLED=0
