    {
      "id": 8,
      "type": "timeseries",
      "title": "Длительность пересчёта, p95",
      "description": "95-й перцентиль по причине пересчёта",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
