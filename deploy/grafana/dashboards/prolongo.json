        "y": 13
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "histogram_quantile(0.95, sum by (le, reason) (rate(prolongo_recalc_duration_seconds_bucket[5m])))",
